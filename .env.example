# Production: serve the built client and WebSockets together.
PORT=3001
HOST=0.0.0.0
# Optional comma-separated, exact browser origins for reverse proxies.
# ALLOWED_ORIGINS=https://haven.example.com
# Optional client override; normally same-origin /ws is used.
# VITE_WS_URL=wss://haven.example.com/ws
# Vercel: leave VITE_WS_URL unset to use the current project/custom domain.
# vercel.json routes /ws to api/ws.js and enables Fluid Compute.
# If ALLOWED_ORIGINS is set, include every browser origin you intend to serve.
